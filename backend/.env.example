# Local development uses SQLite by default. Uncomment to use MySQL:
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/maatricare_db
DATABASE_URL=sqlite:///./maatricare.db
SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SQL_ECHO=false
